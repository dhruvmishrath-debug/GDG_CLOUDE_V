# ─── Server ───
APP_NAME=HealthcarePlatform
DEBUG=true
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_use_openssl_rand_hex_64
ALLOWED_ORIGINS='["http://localhost:5173", "http://localhost:3000"]'

# ─── Database ───
DATABASE_URL=postgresql+asyncpg://healthcare:healthcare@localhost:5432/healthcare_db

# ─── Redis ───
REDIS_URL=redis://localhost:6379/0

# ─── JWT ───
JWT_SECRET_KEY=CHANGE_ME_jwt_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── S3 / MinIO ───
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=healthcare-documents
S3_REGION=us-east-1

# ─── AI: Vision OCR (Google Gemini) ───
# Required for reading handwritten documents.
GOOGLE_API_KEY=your-gemini-key
GEMINI_VISION_MODEL=gemini-1.5-pro

# ─── AI: Clinical structuring (NVIDIA NIM / Nemotron) ───
# Nemotron is text-only: Gemini OCRs the image, Nemotron structures the text.
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_ENABLE_THINKING=true
NVIDIA_REASONING_BUDGET=16384
NVIDIA_MAX_TOKENS=16384
NVIDIA_TEMPERATURE=1.0
NVIDIA_TOP_P=0.95
NVIDIA_TIMEOUT_SECONDS=120
NVIDIA_MAX_RETRIES=3

# ─── Legacy / optional providers ───
# ANTHROPIC_API_KEY=your-anthropic-key
# GROQ_API_KEY=your-groq-key

# ─── Confidence threshold ───
CONFIDENCE_THRESHOLD=0.80
